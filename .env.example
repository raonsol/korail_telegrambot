# Telegram Bot 설정
BOTTOKEN=
BOTTOKEN_DEV=
WEBHOOK_URL=https://example.com/subpath
WEBHOOK_URL_DEV=https://example.com/subpath

# 공공데이터포털 API key (역 검색용)
DATAGOV_API_KEY=your_api_key_here

# Korail 관리자 계정 설정 (이메일/휴대폰(하이픈 포함)/회원번호)
# 주의: 값에 $ 가 있으면 뒤가 변수로 해석되고, " #" 뒤는 주석으로 잘림
#       Docker 는 작은따옴표로 감싸면 그대로 전달됨 (예: ADMIN_KORAIL_PW='ab$c#1')
#       컨테이너가 받은 값은 make korail-login-check 로 확인 (비밀번호는 길이만 표시)
ADMIN_KORAIL_ID=
ADMIN_KORAIL_PW=

# 사용자 관리 설정
# 최초 실행 시 사용자 DB에 등록할 전화번호 (이후에는 웹 관리 화면 또는 봇 /adduser, /deluser로 관리)
ALLOW_LIST=000-0000-0000,000-0000-0000,000-0000-0000
ADMINPW=

# 채널 활성화
ENABLE_TELEGRAM=true
ENABLE_WEBAPP=false

# 데이터베이스 (사용자/웹 세션/예약 이력)
# 기본값: 로컬 SQLite. Docker Compose는 모드별로 자동 설정 (subprocess: SQLite, celery: PostgreSQL)
# DATABASE_URL=sqlite:///./korail_bot.db

# 웹앱 보안 (ENABLE_WEBAPP=true일 때 필수)
# 코레일 비밀번호 암호화 키: 임의의 긴 문자열 (예: openssl rand -base64 32)
# Celery 워커와 웹 서버가 같은 값을 사용해야 합니다.
WEBAPP_ENC_KEY=
# 로그인 유지 세션 수명(시간)
SESSION_TTL_HOURS=168

# Web Push 알림 (make vapid-keys 로 생성)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 예약 설정
MAX_RESERVATIONS_PER_USER=3
RESERVATION_RETENTION_DAYS=30

# Redis 및 Celery 사용여부 (True/False)
# Celery를 사용하지 않는 경우 subprocess 방식으로 동작
USE_CELERY=True