# Telegram Bot 설정
BOTTOKEN=
BOTTOKEN_DEV=
WEBHOOK_URL=https://example.com/subpath
WEBHOOK_URL_DEV=https://example.com/subpath

# 공공데이터포털 API key (역 검색용)
DATAGOV_API_KEY=your_api_key_here

# Cloudflare WARP 프록시 (코레일 API 요청을 WARP 로 우회)
# 로컬 실행: warp-cli 를 proxy 모드로 실행한 뒤 해당 포트를 지정 (make warp-check 로 확인)
# Docker Compose: warp 컨테이너(socks5h://warp:1080)로 자동 설정되므로 이 값은 무시됨
# USE_WARP=false 이면 WARP 없이 코레일에 직접 요청 (Docker 에서는 warp 컨테이너도 실행하지 않음)
USE_WARP=true
WARP_PROXY_URL=socks5h://127.0.0.1:40000
# WARP+ 라이선스 키 (선택, Docker warp 컨테이너에서 사용)
WARP_LICENSE_KEY=

# Korail 관리자 계정 설정 (이메일/휴대폰(하이픈 포함)/회원번호)
# 주의: 값에 $ 가 있으면 뒤가 변수로 해석되고, " #" 뒤는 주석으로 잘림
#       Docker 는 작은따옴표로 감싸면 그대로 전달됨 (예: ADMIN_KORAIL_PW='ab$c#1')
#       컨테이너가 받은 값은 make korail-login-check 로 확인 (비밀번호는 길이만 표시)
ADMIN_KORAIL_ID=
ADMIN_KORAIL_PW=

# 사용자 관리 설정
ALLOW_LIST=000-0000-0000,000-0000-0000,000-0000-0000
ADMINPW=

# Redis 및 Celery 사용여부 (True/False)
# Celery를 사용하지 않는 경우 subprocess 방식으로 동작
USE_CELERY=True